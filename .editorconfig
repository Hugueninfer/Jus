root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.yml]
indent_size = 2

[*.{js,mjs,ts,scss,css}]
indent_size = 2

[*.json]
indent_size = 2

# Composer writes its own files with 4 spaces.
[composer.json]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
