<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Design System e painel de processo eletrônico fictício.">
        <title>{% block title %}Jus{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231f4e79'/%3E%3Ctext x='16' y='23' font-size='20' font-family='sans-serif' text-anchor='middle' fill='%23fff'%3EJ%3C/text%3E%3C/svg%3E">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        <a class="jus-skip-link visually-hidden-focusable position-absolute z-3 top-0 start-0 m-2 p-2 bg-body rounded shadow" href="#conteudo">Pular para o conteúdo</a>

        <header>
            <nav class="navbar navbar-expand-md navbar-dark bg-primary" aria-label="Navegação principal">
                <div class="container">
                    <a class="navbar-brand fw-semibold" href="{{ path('app_home') }}">Jus</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#menu-principal" aria-controls="menu-principal" aria-label="Abrir menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="offcanvas offcanvas-end text-bg-primary" tabindex="-1" id="menu-principal" aria-labelledby="menu-principal-titulo">
                        <div class="offcanvas-header">
                            <h2 class="offcanvas-title h5" id="menu-principal-titulo">Menu</h2>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar menu"></button>
                        </div>
                        <div class="offcanvas-body">
                            <ul class="navbar-nav ms-auto align-items-md-center gap-md-3">
                                {% if app.user %}
                                    {% set on_cases = app.current_route is not null and app.current_route starts with 'case_' %}
                                    <li class="nav-item">
                                        <a class="nav-link{{ on_cases ? ' active' }}" href="{{ path('case_search') }}"{% if on_cases %} aria-current="page"{% endif %}>Processos</a>
                                    </li>
                                {% endif %}
                                <li class="nav-item">
                                    <a class="nav-link{{ app.current_route == 'design_system' ? ' active' }}" href="{{ path('design_system') }}"{% if app.current_route == 'design_system' %} aria-current="page"{% endif %}>Design System</a>
                                </li>
                                {% if app.user %}
                                    <li class="nav-item">
                                        <span class="navbar-text text-white"><i class="bi bi-person-circle" aria-hidden="true"></i> {{ app.user.name }}</span>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ logout_path('main') }}">Sair</a>
                                    </li>
                                {% else %}
                                    <li class="nav-item">
                                        <a class="nav-link{{ app.current_route == 'app_login' ? ' active' }}" href="{{ path('app_login') }}"{% if app.current_route == 'app_login' %} aria-current="page"{% endif %}>Entrar</a>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <main id="conteudo" class="container flex-grow-1 py-4" tabindex="-1">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <twig:Alert :type="type" dismissible>{{ message }}</twig:Alert>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="border-top py-3 small text-body-secondary">
            <div class="container">Projeto de demonstração — todos os dados são fictícios.</div>
        </footer>
    </body>
</html>
