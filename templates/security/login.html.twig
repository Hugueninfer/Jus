{% extends 'base.html.twig' %}

{% block title %}Entrar{% endblock %}

{% block body %}
    <h1>Entrar</h1>

    {% if error %}
        <div role="alert">E-mail ou senha inválidos.</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <label for="username">E-mail</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

        <label for="password">Senha</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Entrar</button>
    </form>
{% endblock %}
