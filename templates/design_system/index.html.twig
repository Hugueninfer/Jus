{% extends 'base.html.twig' %}

{% block title %}Design System · Jus{% endblock %}

{% set sections = {
    'tokens': 'Tokens de design',
    'alert': 'Alert',
    'status-badge': 'StatusBadge',
    'case-card': 'CaseCard',
    'timeline': 'Timeline',
    'deadline-indicator': 'DeadlineIndicator',
    'data-table': 'DataTable',
    'cnj-field': 'Campo de número CNJ',
} %}

{% block body %}
    <h1 class="h2">Design System</h1>
    <p class="lead">Componentes da interface, renderizados a partir do próprio código. Cada exemplo mostra o resultado e o template que o produz; os dados são fictícios.</p>

    <div class="row g-4">
        <nav class="col-12 col-lg-3" aria-label="Componentes">
            <ul class="nav flex-lg-column sticky-lg-top">
                {% for id, title in sections %}
                    <li class="nav-item"><a class="nav-link px-2 px-lg-0" href="#{{ id }}">{{ title }}</a></li>
                {% endfor %}
            </ul>
        </nav>
        <div class="col-12 col-lg-9">
            {% for id, title in sections %}
                <section id="{{ id }}" class="mb-5" aria-labelledby="{{ id }}-titulo">
                    <h2 class="h4" id="{{ id }}-titulo">{{ title }}</h2>
                    {{ include('design_system/sections/' ~ id|replace({'-': '_'}) ~ '.html.twig') }}
                </section>
            {% endfor %}
        </div>
    </div>
{% endblock %}
