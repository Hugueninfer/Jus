{#
    Documentation table. Receives:
      caption   - visually hidden table caption
      headers   - list of column titles
      rows      - list of rows, each a list of cells (the first cell is the name being documented)
      monospace - optional list of column indexes shown as code (default: the first two)

    On narrow screens the last column keeps a readable width and the table scrolls sideways inside its wrapper: a focusable
    region named after the caption, so keyboard users can scroll it and screen readers announce which table it holds.
#}
{% set monospace = monospace ?? [0, 1] %}
<div class="table-responsive mb-3" role="region" tabindex="0" aria-label="{{ caption }}">
    <table class="table table-sm align-middle mb-0">
        <caption class="visually-hidden">{{ caption }}</caption>
        <thead>
            <tr>
                {% for header in headers %}
                    <th scope="col"{% if loop.last %} style="min-width: 14rem"{% endif %}>{{ header }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    {% for cell in row %}
                        {% if loop.first %}
                            <th scope="row" class="text-nowrap"><code>{{ cell }}</code></th>
                        {% elseif loop.index0 in monospace %}
                            <td><code>{{ cell }}</code></td>
                        {% else %}
                            <td>{{ cell }}</td>
                        {% endif %}
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
