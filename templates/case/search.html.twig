{% extends 'base.html.twig' %}

{% block title %}Processos · Jus{% endblock %}

{% block body %}
    <h1 class="h2 mb-3">Processos</h1>

    {# The filters in use (a field left empty is none) and whether any field has an error: the panel stays open for
       either, and its summary counts the filters. #}
    {% set filters_in_use = [form.numero, form.parte, form.status]|filter(field => field.vars.value is not empty)|length %}
    {% set filters_active = filters_in_use > 0 or not form.vars.valid %}

    {# The filters, then the results (components/_search.scss). From lg up the filters are a column of their own, the
       summary of their panel hidden. Below lg the panel is above the results: the server sends it open, so that without
       JavaScript the filters are simply there, and assets/behaviours/filters-panel.ts folds it when no filter is in use
       and no field has an error. #}
    <div class="row g-4 jus-search">
        <div class="col-12 col-lg-4 col-xxl-3 jus-search-filters">
            <details class="jus-filters" open data-jus-filters-active="{{ filters_active ? 'true' : 'false' }}">
                <summary><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar{% if filters_in_use > 0 %} · {{ filters_in_use }} {{ filters_in_use == 1 ? 'filtro' : 'filtros' }}{% endif %}<i class="bi bi-chevron-down jus-filters-chevron" aria-hidden="true"></i></summary>

                {{ form_start(form, {attr: {class: 'jus-surface jus-filters-form', role: 'search', 'aria-label': 'Buscar processos'}}) }}
                    {{ form_row(form.numero) }}
                    {{ form_row(form.parte) }}
                    {{ form_row(form.status) }}
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="submit" class="btn btn-primary">Buscar</button>
                        <a class="btn btn-link" href="{{ path('case_search') }}">Limpar</a>
                    </div>
                {{ form_end(form, {render_rest: false}) }}
            </details>
        </div>

        <div class="col-12 col-lg-8 col-xxl-9 jus-search-results">
            {% if result is not null %}
                <h2 class="h4" id="resultados" tabindex="-1">
                    {{ result.total }} {{ result.total == 1 ? 'processo encontrado' : 'processos encontrados' }}
                </h2>

                {% if result.cases is empty %}
                    <twig:Alert type="info">Nenhum processo encontrado.</twig:Alert>
                {% else %}
                    <ul class="list-unstyled row g-3 jus-case-list" role="list">
                        {% for case in result.cases %}
                            <li class="col-12 col-xl-6">
                                <twig:CaseCard :case="case" :latestEvent="latestEvents[case.id] ?? null" :latestEventKnown="true" :href="path('case_show', {numero: case.number.formatted})" />
                            </li>
                        {% endfor %}
                    </ul>
                    <twig:Pagination :page="result.page" :pages="result.pages" label="Paginação dos resultados" anchor="resultados" />
                {% endif %}
            {% endif %}
        </div>
    </div>
{% endblock %}
