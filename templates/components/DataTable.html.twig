{% set sortable = columns|filter(column => column.sortable ?? false) %}
<div class="jus-data-table-wrapper">
    {# The header row is hidden in card mode, so below md the sort links are repeated here, with the hint the header leaves to aria-sort. #}
    {% if sortable|length > 0 %}
        <nav class="jus-data-table-sort d-md-none" aria-label="{{ caption ? 'Ordenar: ' ~ caption : 'Ordenar tabela' }}">
            <span class="jus-data-table-sort-label text-body-secondary">Ordenar por:</span>
            {% for column in sortable %}
                <a href="{{ this.sortHref(column.key) }}"{% if this.activeSort == column.key %} aria-current="true"{% endif %}>
                    {{- column.label -}}
                    {%- if this.activeSort == column.key %} <span aria-hidden="true">({{ this.activeDirection == 'asc' ? 'crescente' : 'decrescente' }})</span>{% endif -%}
                    <span class="visually-hidden">{{ this.sortHint(column.key) }}</span>
                </a>
            {% endfor %}
        </nav>
    {% endif %}
    {# Only the table scrolls sideways (a very long unbreakable value on wide screens): a scroll container would clip the focus ring of the sort links above. #}
    <div class="table-responsive">
        <table {{ attributes.defaults({class: 'table align-middle jus-data-table'}) }}>
            {% if caption %}
                <caption>{{ caption }}</caption>
            {% endif %}
            <thead>
                <tr>
                    {% for column in columns %}
                        {% if column.sortable ?? false %}
                            <th scope="col" aria-sort="{{ this.ariaSort(column.key) }}">
                                <a href="{{ this.sortHref(column.key) }}">
                                    {{- column.label -}}
                                    {% if this.activeSort == column.key %}
                                        <i class="bi bi-caret-{{ this.activeDirection == 'asc' ? 'up' : 'down' }}-fill" aria-hidden="true"></i>
                                    {% endif %}
                                </a>
                            </th>
                        {% else %}
                            <th scope="col">{{ column.label }}</th>
                        {% endif %}
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in this.sortedRows %}
                    <tr>
                        {% for column in columns %}
                            {% set value = row[column.key] ?? null %}
                            {% set format = column.format ?? null %}
                            {% set href = column.href is defined ? row[column.href] ?? null : null %}
                            {% set text %}
                                {%- if value is null -%}
                                    —
                                {%- elseif format == 'date' -%}
                                    {{ value|date('d/m/Y') }}
                                {%- elseif format == 'datetime' -%}
                                    {{ value|date('d/m/Y H:i') }}
                                {%- elseif format == 'bytes' -%}
                                    {{ value|bytes }}
                                {%- elseif format == 'brl' -%}
                                    {{ value|brl }}
                                {%- elseif format == 'label' -%}
                                    {{ value|label }}
                                {%- else -%}
                                    {{ value }}
                                {%- endif -%}
                            {% endset %}
                            <td data-label="{{ column.label }}">
                                {%- if href is not null and value is not null -%}
                                    <a href="{{ href }}">{{ text }}</a>
                                {%- else -%}
                                    {{ text }}
                                {%- endif -%}
                            </td>
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ columns|length }}" class="text-body-secondary">{{ emptyMessage }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
