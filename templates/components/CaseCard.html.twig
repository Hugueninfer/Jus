<article {{ attributes.defaults({class: 'card jus-case-card h-100'}) }}>
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
            <h3 class="h6 mb-0 font-monospace">
                {% if href %}
                    <a href="{{ href }}" class="stretched-link">{{ case.number|cnj }}</a>
                {% else %}
                    {{ case.number|cnj }}
                {% endif %}
            </h3>
            <div class="d-flex flex-wrap gap-1">
                {% if case.confidential %}
                    <span class="badge text-bg-dark"><i class="bi bi-lock" aria-hidden="true"></i> Sigiloso</span>
                {% endif %}
                <twig:StatusBadge :status="case.status" />
            </div>
        </div>
        <p class="mb-1 fw-semibold">{{ case.caseClass }}</p>
        <p class="mb-2 text-body-secondary">{{ case.subject }} · {{ case.court }}</p>
        <dl class="row small mb-2">
            {% for side in this.sides %}
                <dt class="col-sm-4">{{ side.side|label }}</dt>
                {% for party in side.parties %}
                    <dd class="col-sm-8 mb-1{{ loop.first ? '' : ' offset-sm-4' }}">{{ party.name }}</dd>
                {% else %}
                    <dd class="col-sm-8 mb-1">—</dd>
                {% endfor %}
            {% endfor %}
        </dl>
        {% set last = this.lastEvent %}
        {% if last %}
            <p class="small mb-0 jus-case-card-last-event">
                <span class="text-body-secondary">Última movimentação:</span>
                <time datetime="{{ last.occurredAt|date('c') }}">{{ last.occurredAt|date('d/m/Y') }}</time> — {{ last.type|label }}
            </p>
        {% endif %}
    </div>
</article>
